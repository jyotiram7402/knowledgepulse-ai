# --------- Python backend environment ---------
# Neon gives you this exact format - paste it as-is (keep sslmode=require).
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION_MINUTES=1440

# Gemini
GEMINI_API_KEY=AIza...
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=changeme

# CORS + admin seed
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
ADMIN_EMAIL=admin@knowledgepulse.ai
ADMIN_PASSWORD=ChangeMe!123

# --------- Optional: defaults live in app/config.py ---------
# JWT_ISSUER=knowledgepulse-ai
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Must stay 768 unless database/schema.sql and app/models.py change too.
# EMBEDDING_DIMENSIONS=768
# CLOUDINARY_FOLDER=knowledgepulse
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# TOP_K=5
# SIMILARITY_THRESHOLD=0.20
# PORT is read only by the Dockerfile / Render start command (default 8080).

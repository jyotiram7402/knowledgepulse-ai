# --------- Python backend environment ---------
# Neon gives you this exact format - paste it as-is (keep sslmode=require).
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION_MINUTES=1440

# Gemini
GEMINI_API_KEY=AIza...
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=changeme

# CORS + admin seed
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
ADMIN_EMAIL=admin@knowledgepulse.ai
ADMIN_PASSWORD=ChangeMe!123
